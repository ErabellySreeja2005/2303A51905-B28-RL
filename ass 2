        "import random\n",
        "machines = ['A', 'B', 'C']\n",
        "\n",
        "N_play = 10\n",
        "\n",
        "epsilon = 0.2\n",
        "\n",
        "N = {\n",
        "    'A': 0,\n",
        "    'B': 0,\n",
        "    'C': 0\n",
        "}\n",
        "\n",
        "R = {\n",
        "    'A': [],\n",
        "    'B': [],\n",
        "    'C': []\n",
        "}\n",
        "\n",
        "Q = {\n",
        "    'A': 0.0,\n",
        "    'B': 0.0,\n",
        "    'C': 0.0\n",
        "}\n",
        "\n",
        "total_reward = 0\n",
        "for play in range(1, N_play + 1):\n",
        "\n",
        "    r = random.random()\n",
        "\n",
        "    if r < epsilon:\n",
        "        # Exploration\n",
        "        machine = random.choice(machines)\n",
        "        decision = \"Exploration\"\n",
        "    else:\n",
        "        # Exploitation\n",
        "        max_q = max(Q.values())\n",
        "\n",
        "        best_machines = [\n",
        "            m for m in machines\n",
        "            if Q[m] == max_q\n",
        "        ]\n",
        "\n",
        "        machine = random.choice(best_machines)\n",
        "        decision = \"Exploitation\"\n",
        "\n",
        "    print(f\"\\nPlay {play}\")\n",
        "    print(f\"Random number = {r:.2f}\")\n",
        "    print(f\"Decision = {decision}\")\n",
        "    print(f\"Selected Machine = {machine}\")\n",
        "    reward = float(input(\"Enter reward: \"))\n",
        "\n",
        "    N[machine] += 1\n",
        "    R[machine].append(reward)\n",
        "\n",
        "    Q[machine] = Q[machine] + (\n",
        "        (reward - Q[machine]) / N[machine]\n",
        "    )\n",
        "\n",
        "    total_reward += reward\n",
        "    print(f\"N({machine}) = {N[machine]}\")\n",
        "    print(f\"Q({machine}) = {Q[machine]:.2f}\")\n",
        "print(\"\\n========== FINAL RESULTS ==========\")\n",
        "\n",
        "print(\"\\nN Table:\")\n",
        "for machine in machines:\n",
        "    print(f\"N({machine}) = {N[machine]}\")\n",
        "\n",
        "print(\"\\nR Table:\")\n",
        "for machine in machines:\n",
        "    print(f\"R({machine}) = {R[machine]}\")\n",
        "\n",
        "print(\"\\nQ Table:\")\n",
        "for machine in machines:\n",
        "    print(f\"Q({machine}) = {Q[machine]:.2f}\")\n",
        "\n",
        "print(f\"\\nTotal Reward after 10 plays = {total_reward:g}\")"
      ]
