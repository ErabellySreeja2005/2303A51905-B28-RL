        "import random\n",
        "\n",
        "machines = ['A', 'B', 'C']\n",
        "\n",
        "N_play = 10\n",
        "\n",
        "epsilon = 0.2\n",
        "\n",
        "N = {'A': 0, 'B': 0, 'C': 0}\n",
        "R = {'A': 0, 'B': 0, 'C': 0}\n",
        "Q = {'A': 0, 'B': 0, 'C': 0}\n",
        "\n",
        "total_reward = 0\n",
        "\n",
        "for play in range(1, N_play + 1):\n",
        "\n",
        "    r = random.random()\n",
        "\n",
        "    max_Q = max(Q.values())\n",
        "    best_machines = [m for m in machines if Q[m] == max_Q]\n",
        "\n",
        "    if r < epsilon:\n",
        "        exploration_machines = [\n",
        "            m for m in machines if m not in best_machines\n",
        "        ]\n",
        "\n",
        "        # If all machines are currently tied, we can explore any of them\n",
        "        if not exploration_machines:\n",
        "            selected_machine = random.choice(machines)\n",
        "        else:\n",
        "            selected_machine = random.choice(exploration_machines)\n",
        "\n",
        "        decision = \"Exploration\"\n",
        "\n",
        "    else:\n",
        "        selected_machine = random.choice(best_machines)\n",
        "        decision = \"Exploitation\"\n",
        "\n",
        "    print(\"\\nPlay\", play)\n",
        "    print(\"Random number:\", round(r, 4))\n",
        "    print(\"Decision:\", decision)\n",
        "    print(\"Play with machine\", selected_machine)\n",
        "\n",
        "    reward = float(input(\"Enter reward: \"))\n",
        "\n",
        "    N[selected_machine] += 1\n",
        "    R[selected_machine] += reward\n",
        "\n",
        "    Q[selected_machine] = (\n",
        "        Q[selected_machine]\n",
        "        + (1 / N[selected_machine])\n",
        "        * (reward - Q[selected_machine])\n",
        "    )\n",
        "\n",
        "    total_reward += reward\n",
        "\n",
        "    print(\"Updated Q-value of\", selected_machine, \"=\",\n",
        "          round(Q[selected_machine], 2))\n",
        "\n",
        "print(\"\\n\" + \"=\" * 50)\n",
        "print(\"FINAL RESULTS\")\n",
        "print(\"=\" * 50)\n",
        "\n",
        "print(\"\\nMachine\\tN\\tR\\tQ\")\n",
        "\n",
        "for machine in machines:\n",
        "    print(\n",
        "        machine,\n",
        "        \"\\t\",\n",
        "        N[machine],\n",
        "        \"\\t\",\n",
        "        R[machine],\n",
        "        \"\\t\",\n",
        "        round(Q[machine], 2)\n",
        "    )\n",
        "\n",
        "print(\"\\nTotal Reward =\", total_reward)"
