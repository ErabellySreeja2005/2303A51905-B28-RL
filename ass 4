        "# Assignment: Upper Confidence Bound for Multi-Armed Bandit\n",
        "# Objective: Implement the Upper Confidence Bound (UCB) for a Multi-Armed Bandit problem and estimate the future reward (Q-value) of each machine using the incremental sample-average method.\n",
        "\n",
        "import math\n",
        "\n",
        "machines = ['A', 'B', 'C']\n",
        "\n",
        "N_play = 10\n",
        "\n",
        "N = {machine: 0 for machine in machines}\n",
        "R = {machine: [] for machine in machines}\n",
        "Q = {machine: 0.0 for machine in machines}\n",
        "UCB = {machine: 0.0 for machine in machines}\n",
        "\n",
        "total_reward = 0\n",
        "\n",
        "print(\"Upper Confidence Bound Multi-Armed Bandit\")\n",
        "print(\"-\" * 50)\n",
        "\n",
        "for t in range(1, N_play + 1):\n",
        "\n",
        "    print(f\"\\nPlay {t}\")\n",
        "    for machine in machines:\n",
        "        if N[machine] == 0:\n",
        "            UCB[machine] = float('inf')\n",
        "        else:\n",
        "            UCB[machine] = Q[machine] + math.sqrt(\n",
        "                (2 * math.log(t)) / N[machine]\n",
        "            )\n",
        "    print(\"\\nUCB Values:\")\n",
        "    for machine in machines:\n",
        "        if UCB[machine] == float('inf'):\n",
        "            print(f\"{machine}: Infinity\")\n",
        "        else:\n",
        "            print(f\"{machine}: {UCB[machine]:.3f}\")\n",
        "    selected_machine = max(machines, key=lambda x: UCB[x])\n",
        "\n",
        "    print(f\"\\nPlay with machine {selected_machine}\")\n",
        "\n",
        "    # Safe float input handling to avoid ValueError\n",
        "    while True:\n",
        "        user_input = input(\"Enter reward (or press Enter for 0.0): \").strip()\n",
        "        if user_input == \"\":\n",
        "            reward = 0.0\n",
        "            break\n",
        "        try:\n",
        "            reward = float(user_input)\n",
        "            break\n",
        "        except ValueError:\n",
        "            print(\"Invalid input. Please enter a numerical value.\")\n",
        "\n",
        "    N[selected_machine] += 1\n",
        "    R[selected_machine].append(reward)\n",
        "    Q[selected_machine] = Q[selected_machine] + (\n",
        "        (reward - Q[selected_machine]) / N[selected_machine]\n",
        "    )\n",
        "    total_reward += reward\n",
        "\n",
        "    print(f\"Updated Q-value of {selected_machine}: \"\n",
        "          f\"{Q[selected_machine]:.3f}\")\n",
        "\n",
        "print(\"\\n\" + \"=\" * 60)\n",
        "print(\"FINAL RESULTS\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "print(f\"{'Machine':<10}{'N':<10}{'Rewards':<25}{'UCB':<12}{'Q-value'}\")\n",
        "print(\"-\" * 75)\n",
        "\n",
        "for machine in machines:\n",
        "\n",
        "    if UCB[machine] == float('inf'):\n",
        "        ucb_value = \"Infinity\"\n",
        "    else:\n",
        "        ucb_value = f\"{UCB[machine]:.3f}\"\n",
