        "        f\"{N[machine]:<10}\"\n",
        "        f\"{str(R[machine]):<25}\"\n",
        "        f\"{ucb_value:<12}\"\n",
        "        f\"{Q[machine]:.3f}\"\n",
        "    )\n",
        "\n",
        "print(\"-\" * 75)\n",
        "print(f\"\\nTotal Reward Received = {total_reward}\")"
